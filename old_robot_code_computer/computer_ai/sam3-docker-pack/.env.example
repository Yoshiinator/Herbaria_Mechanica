# HuggingFace token (required if model is not in ./models)
# Get token: https://huggingface.co/settings/tokens
# Request model access: https://huggingface.co/facebook/sam3
HF_TOKEN=your_huggingface_token_here

# Optional
# LOG_LEVEL=INFO
# ALLOWED_BASE_PATHS=/data,/outputs,/home/node/.n8n-files,/mnt
# RESULT_STORAGE_PATH=/outputs

# Output Options (boolean: true/false)
# SAVE_COMBINED_MASK_PER_LABEL=false
# SAVE_ALL_COMBINED_MASK=false
# SHOW_BOUNDING_BOX_LABELS=true
# CORNER_ANNOTATION_ENABLED=true
# CORNER_ANNOTATION_POSITION=bottom-right
